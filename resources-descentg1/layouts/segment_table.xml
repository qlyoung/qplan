<layout id="SegmentTableLayout" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://developer.garmin.com/downloads/connect-iq/resources.xsd">
    <drawable id="Background_white" />

    <!-- Cylinder type in the stupid circle -->
    <label id="cylinderTypeLabel" x="83%" y="11%" text="" font="Graphics.FONT_SYSTEM_LARGE" color="Graphics.COLOR_BLACK" justification="Graphics.TEXT_JUSTIFY_CENTER" />

    <!-- SCR & segment length to the left -->
    <label id="scrLabel" x="8%" y="15%" font="Graphics.FONT_TINY" color="Graphics.COLOR_BLACK" justification="Graphics.TEXT_JUSTIFY_LEFT" />
    <label id="timeLabel" x="8%" y="25%" font="Graphics.FONT_TINY" color="Graphics.COLOR_BLACK" justification="Graphics.TEXT_JUSTIFY_LEFT" />

    <!-- Table content text area -->
    <label id="segmentTableText" y="42%" x="0" font="Graphics.FONT_TINY" color="Graphics.COLOR_BLACK" justification="Graphics.TEXT_JUSTIFY_LEFT" />

    <!-- Scroll indicators -->
    <label id="scrollIndicatorUp" x="5%" y="45%" text="@Strings.UpArrow" font="Graphics.FONT_TINY" color="Graphics.COLOR_BLACK" justification="Graphics.TEXT_JUSTIFY_CENTER" />
    <label id="scrollIndicatorDown" x="5%" y="55%" text="@Strings.DownArrow" font="Graphics.FONT_TINY" color="Graphics.COLOR_BLACK" justification="Graphics.TEXT_JUSTIFY_CENTER" />
</layout>