<layout id="NumberSelectionLayout" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://developer.garmin.com/downloads/connect-iq/resources.xsd">
    <drawable id="Background_black" />

    <!-- Title text -->
    <label id="titleLabel" x="35%" y="15%" font="Graphics.FONT_SYSTEM_LARGE" color="Graphics.COLOR_WHITE" justification="Graphics.TEXT_JUSTIFY_CENTER" />

    <!-- Value text -->
    <label id="valueLabel" x="50%" y="40%" font="Graphics.FONT_LARGE" color="Graphics.COLOR_WHITE" justification="Graphics.TEXT_JUSTIFY_CENTER" />

    <!-- Instruction text -->
    <label id="instructionLabel" x="50%" y="70%" text="UP/DOWN to adjust" font="Graphics.FONT_TINY" color="Graphics.COLOR_WHITE" justification="Graphics.TEXT_JUSTIFY_CENTER" />
</layout>
